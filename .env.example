# Firebase Web App Configuration Template for CineLive
# Replace these placeholder values with your Firebase Project Configuration
# In Cloudflare Pages, add these under Settings > Environment variables
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_FIRESTORE_DATABASE_ID=your_firestore_database_id_or_default
